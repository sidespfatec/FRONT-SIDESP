{
  "name": "SIDESP — Angular, Java e MariaDB",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/FRONT-SIDESP",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "24", "npmVersion": "11.19.0", "pnpmVersion": "none" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "4200": { "label": "SIDESP — abrir aplicação", "onAutoForward": "notify", "visibility": "private" },
    "8080": { "label": "SIDESP — API", "onAutoForward": "silent", "visibility": "private" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Angular.ng-template", "vscjava.vscode-java-pack", "vmware.vscode-spring-boot", "cweijan.vscode-mysql-client2"],
      "settings": { "java.configuration.updateBuildConfiguration": "automatic", "files.eol": "\n" }
    }
  }
}
